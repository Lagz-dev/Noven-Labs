# Example environment variables for Noven Labs chatbot

# Gemini key: use your Gemini API key or bearer token here.
GEMINI_API_KEY=SUA-CHAVE-AQUI

# Optional: change the Gemini model if needed.
GEMINI_MODEL=gemini-1.5-mini

# Optional: custom Gemini endpoint URL.
GEMINI_API_URL=https://gemini.googleapis.com/v1/models/gemini-1.5-mini:generateText
